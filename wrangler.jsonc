{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mcp",
	"account_id": "716a7bbe6f8e024b864ac3ccbb4832f7",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"issues": { "enabled": true },
		"logs": { "enabled": true },
		"traces": { "enabled": true }
	},
	"vars": {
		"CLOUDFLARE_API_BASE": "https://api.cloudflare.com/client/v4",
		"CLOUDFLARE_OAUTH_DOMAIN": "https://dash.cloudflare.com",
		"MCP_RESOURCE": "https://mcp.nfr-in-softcell.workers.dev/mcp",
		"RESPONSE_VALIDATION_SAMPLE_RATE": "1"
	},
	"worker_loaders": [
		{ "binding": "LOADER" }
	],
	"services": [
		{
			"binding": "GLOBAL_OUTBOUND",
			"service": "mcp",
			"entrypoint": "GlobalOutbound"
		},
		{
			"binding": "FORGE_TOOLS",
			"service": "cloudflare-api-mcp-forge-tools-dev"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "4bcbba57df4f4d4d8f05dfac2853dbf0"
		}
	],
	"r2_buckets": [
		{
			"binding": "SPEC_BUCKET",
			"bucket_name": "mcp-spec"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "MCP_METRICS",
			"dataset": "mcp-metrics-dev"
		}
	],
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	"dev": {
		"port": 2529
	}
}
