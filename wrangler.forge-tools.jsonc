{
	// The forge tools service (src/forge-tools/worker.ts): the generated direct
	// tools served at /mcp?codemode=false&experimentalForge=true, which the main
	// Worker (wrangler.jsonc) reaches over its FORGE_TOOLS service binding, and
	// Code Mode's search, which runs in a LOADER sandbox next to the spec it
	// ships. It holds no credentials, makes no requests, and has no public route. Workers Builds deploys it with
	// the main Worker on every push to main. In a new environment, deploy it
	// first, since the main Worker binds to it.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cloudflare-api-mcp-forge-tools-dev",
	"account_id": "716a7bbe6f8e024b864ac3ccbb4832f7",
	"main": "src/forge-tools/worker.ts",
	"compatibility_date": "2026-06-17",
	"workers_dev": false,
	"preview_urls": false,
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"env": {
		"staging": {
			"name": "cloudflare-api-mcp-forge-tools-staging",
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			]
		},
		"production": {
			"name": "cloudflare-api-mcp-forge-tools",
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			]
		}
	}
}
